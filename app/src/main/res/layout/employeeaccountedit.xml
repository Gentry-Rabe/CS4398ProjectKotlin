<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context="com.example.fixcsproject.ui.login.EmployeeAccountEditActivity">

    <EditText
        android:id="@+id/employeeidchange"
        android:layout_width="378dp"
        android:layout_height="60dp"
        android:layout_marginTop="112dp"
        android:hint="Change ID"
        android:inputType="textEmailAddress"
        android:selectAllOnFocus="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/registerpasswordchange"
        android:layout_width="378dp"
        android:layout_height="60dp"
        android:layout_marginTop="172dp"
        android:hint="New Password"
        android:selectAllOnFocus="true"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/currentpassword"
        android:layout_width="378dp"
        android:layout_height="60dp"
        android:layout_marginTop="376dp"
        android:hint="Current Password"
        android:selectAllOnFocus="true"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/registerpasswordchangeconfirm"
        android:layout_width="378dp"
        android:layout_height="60dp"
        android:layout_marginTop="232dp"
        android:hint="Confirm New Password"
        android:selectAllOnFocus="true"
        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/employeeemailchange"
        android:layout_width="378dp"
        android:layout_height="60dp"
        android:layout_marginTop="52dp"
        android:hint="Change Email"
        android:inputType="textEmailAddress"
        android:selectAllOnFocus="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitemployeeinfochange"
        android:layout_width="215dp"
        android:layout_height="50dp"
        android:layout_gravity="start"
        android:layout_marginBottom="200dp"
        android:text="Submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelemployeeinfochange"
        android:layout_width="110dp"
        android:layout_height="51dp"
        android:layout_gravity="start"
        android:layout_marginBottom="144dp"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/EmployeeChangeInfoReminder"
        android:layout_width="278dp"
        android:layout_height="44dp"
        android:text="Input values you would like to change,\nthen press 'submit'"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/employeeemailchange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/wrongpasswordemployee"
        android:layout_width="278dp"
        android:layout_height="44dp"
        android:layout_marginEnd="48dp"
        android:text=""
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/registerpasswordchangeconfirm"
        tools:layout_editor_absoluteY="308dp" />


</androidx.constraintlayout.widget.ConstraintLayout>