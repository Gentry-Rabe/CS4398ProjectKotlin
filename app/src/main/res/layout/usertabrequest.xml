<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/requestError"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:textAlignment="center"
        android:textColor="@android:color/holo_red_dark" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/JobTypeUser"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:hint="Job Type Select" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/jobAddressUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Job Address" />

    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView2"
        android:layout_width="match_parent"
        android:layout_height="274dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/JobDescUser"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:hint="Job Description" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/JobPriceUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/OptReqUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional Employee Request" />

    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Example Text: Job Posting Disclaimer" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/submitJobUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Job" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Request" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/AccountButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="My Account" />
    </LinearLayout>

</LinearLayout>